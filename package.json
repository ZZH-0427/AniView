{
  "name": "aniview",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node tools/release/check-build.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node tools/stability/run-browser.mjs core",
    "test:release-ui": "node tools/stability/run-browser.mjs release-ui",
    "test:stress": "node tools/stability/run-browser.mjs stress",
    "test:soak": "node tools/stability/run-browser.mjs soak"
  },
  "dependencies": {
    "@zip.js/zip.js": "2.23.0",
    "apng-js": "1.1.5",
    "omggif": "1.0.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "6.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
